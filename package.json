{
  "name": "@rdcp/sdk",
  "version": "1.0.0",
  "description": "JavaScript/TypeScript SDK for Runtime Debug Control Protocol (RDCP) v1.0",
  "keywords": [
    "rdcp",
    "runtime-debug",
    "debug-control",
    "observability",
    "logging",
    "sdk"
  ],
  "author": {
    "name": "RDCP SDK Team",
    "email": "dev@rdcp.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdcp/sdk"
  },
  "homepage": "https://rdcp.dev",
  "bugs": {
    "url": "https://github.com/rdcp/sdk/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "WARP.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.esm.js",
      "require": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.esm.js",
      "require": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.esm.js",
      "require": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch examples/express/server.js",
    "dev:background": "nohup npm run dev > dev.log 2>&1 &",
    "dev:full-clean": "rm -rf node_modules package-lock.json && npm install && npm run dev",
    "cleanup": "pkill -f 'tsx watch' || true",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "lint": "eslint src --ext .js,.ts --fix",
    "lint:check": "eslint src --ext .js,.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "start": "node dist/examples/express/server.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "release": "semantic-release",
    "clean": "rm -rf dist coverage .nyc_output"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vitest/coverage-v8": "^1.1.3",
    "@vitest/ui": "^1.1.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "express": "^4.18.2",
    "fastify": "^4.25.2",
    "prettier": "^3.1.1",
    "rollup": "^4.9.2",
    "rollup-plugin-dts": "^6.1.0",
    "semantic-release": "^22.0.12",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitepress": "^1.0.0-rc.39",
    "vitest": "^1.1.3"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "fastify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}