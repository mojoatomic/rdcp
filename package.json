{
  "name": "@rdcp.dev/server",
  "version": "2.3.0",
  "description": "JavaScript/TypeScript SDK for Runtime Debug Control Protocol v1.0 endpoints",
  "keywords": [
    "rdcp",
    "runtime-debug",
    "debug-control",
    "observability",
    "logging",
    "sdk",
    "express",
    "fastify",
    "koa",
    "nextjs",
    "middleware",
    "authentication",
    "multi-tenant"
  ],
  "license": "Apache-2.0",
  "author": "Doug Fennell <doug@rdcp.dev> (https://github.com/mojoatomic)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojoatomic/rdcp.git"
  },
  "bugs": {
    "url": "https://github.com/rdcp/sdk/issues"
  },
  "homepage": "https://rdcp.dev",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/types/src/auth/index.d.ts",
      "import": "./dist/auth/index.esm.js",
      "require": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./server": {
      "types": "./dist/types/src/server/index.d.ts",
      "import": "./dist/server/index.esm.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/types/src/client/index.d.ts",
      "import": "./dist/client/index.esm.js",
      "require": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "gen:error-codes": "npm run build && node scripts/generate-error-codes-doc.mjs",
    "docs:check-links": "node scripts/check-wiki-links.js",
    "docs:check-links:external": "node scripts/check-wiki-links.js --external",
    "dev": "tsx watch examples/express-server.ts",
    "dev:background": "nohup npm run dev > dev.log 2>&1 &",
    "dev:full-clean": "rm -rf node_modules package-lock.json && npm install && npm run dev",
    "cleanup": "pkill -f 'tsx watch' || true",
    "build:core": "tsc -p packages/rdcp-core/tsconfig.json && tsc -p packages/rdcp-core/tsconfig.cjs.json",
    "build:client": "tsc -p packages/rdcp-client/tsconfig.json && tsc -p packages/rdcp-client/tsconfig.cjs.json",
    "build:admin": "npm run build --prefix packages/rdcp-admin-ui && npm run build --prefix packages/rdcp-admin-ui-react && npm run build --prefix packages/rdcp-admin-app",
    "build:otel": "npm run build --prefix packages/otel-plugin",
    "build:types": "tsc -p tsconfig.types.json",
    "build:js": "rollup -c rollup.config.mjs",
    "build": "npm run build:core && npm run build:client && npm run build:admin && npm run build:otel && npm run build:types && npm run build:js",
    "demo:proof": "bash scripts/demo-proof.sh",
    "demo:client": "node --enable-source-maps scripts/client-demo.mjs",
    "demo:client:auth": "node --enable-source-maps scripts/client-auth-examples.mjs",
    "lint": "eslint src examples --no-error-on-unmatched-pattern --ext .js,.ts --fix",
    "lint:ci": "eslint src examples --no-error-on-unmatched-pattern --ext .js,.ts --max-warnings=0",
    "pretest": "npm run build:core && npm run build:client && npm run build && ( [ \"$CI\" = \"true\" ] || npm install --prefix packages/rdcp-demo-app --no-audit --no-fund )",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:examples": "tsc --noEmit --project tsconfig.json examples/express-server.ts",
    "clean": "rm -rf dist coverage .nyc_output",
    "prepare": "husky install",
    "wiki:check": "bash scripts/check-wiki-links.sh"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.md": "node scripts/check-wiki-links.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@rdcp.dev/admin-ui": "file:packages/rdcp-admin-ui",
    "@rdcp.dev/admin-ui-react": "file:packages/rdcp-admin-ui-react",
    "@rdcp.dev/core": "file:packages/rdcp-core",
    "@rdcp.dev/server": "^2.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.4",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rdcp.dev/client": "file:packages/rdcp-client",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^3.0.0",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "express": "^4.18.2",
    "fastify": "^4.25.2",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "koa": "^2.14.2",
    "lint-staged": "^15.2.9",
    "prettier": "^3.1.1",
    "rollup": "^4.9.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "fastify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "typescript": "5.3.3",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "type": "commonjs"
}
