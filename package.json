{
  "name": "@rdcp/server",
  "version": "1.1.0",
  "description": "JavaScript/TypeScript SDK for Runtime Debug Control Protocol v1.0 endpoints",
  "keywords": [
    "rdcp",
    "runtime-debug",
    "debug-control",
    "observability",
    "logging",
    "sdk",
    "express",
    "fastify",
    "koa",
    "nextjs",
    "middleware",
    "authentication",
    "multi-tenant"
  ],
  "license": "MIT",
  "author": {
    "name": "Doug Fennell",
    "email": "doug@rdcp.dev",
    "url": "https://github.com/mojoatomic"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mojoatomic/rdcp"
  },
  "bugs": {
    "url": "https://github.com/rdcp/sdk/issues"
  },
  "homepage": "https://rdcp.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.esm.js",
      "require": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.esm.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.esm.js",
      "require": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "docs:check-links": "node scripts/check-wiki-links.js",
    "docs:check-links:external": "node scripts/check-wiki-links.js --external",
    "dev": "tsx watch examples/express-server.ts",
    "dev:background": "nohup npm run dev > dev.log 2>&1 &",
    "dev:full-clean": "rm -rf node_modules package-lock.json && npm install && npm run dev",
    "cleanup": "pkill -f 'tsx watch' || true",
    "build": "tsc && rollup -c rollup.config.mjs",
    "demo:proof": "bash scripts/demo-proof.sh",
    "lint": "eslint src examples --no-error-on-unmatched-pattern --ext .js,.ts --fix",
    "lint:ci": "eslint src examples --no-error-on-unmatched-pattern --ext .js,.ts --max-warnings=0",
    "pretest": "npm run build && ( [ \"$CI\" = \"true\" ] || npm ci --prefix packages/rdcp-demo-app )",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "type-check:examples": "tsc --noEmit --project tsconfig.json examples/express-server.ts",
    "clean": "rm -rf dist coverage .nyc_output"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.4",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/koa": "^3.0.0",
    "@types/node": "^20.10.6",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "express": "^4.18.2",
    "fastify": "^4.25.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "rollup": "^4.9.2",
    "rollup-plugin-dts": "^6.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "fastify": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "typescript": "5.3.3"
}
