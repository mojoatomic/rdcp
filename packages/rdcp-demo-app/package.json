{
  "name": "@rdcp/demo-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Doug Fennell",
    "email": "technical@c2cfirm.com",
    "url": "https://github.com/mojoatomic"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mojoatomic/rdcp",
    "directory": "packages/rdcp-demo-app"
  },
  "description": "Comprehensive RDCP + OpenTelemetry demonstration app with Express and Jaeger",
  "scripts": {
    "dev": "node src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "otel": "node --require ./src/opentelemetry.js src/server.js",
    "dev:upstream": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 OTEL_SERVICE_NAME=upstream-service node --require ./src/opentelemetry.js ./src/upstream-service.js",
    "benchmark": "node scripts/benchmark.js",
    "examples": "node scripts/test-examples.js",
    "test": "jest",
    "build": "echo 'No build step needed (pure JS demo)'",
    "gen:mtls-cert": "node scripts/gen-mtls-cert.js",
    "gen:jwt": "node scripts/mint-jwt.js",
    "demo:start:memory": "./scripts/run-inmemory-demo.sh",
    "demo:stop:memory": "./scripts/stop-inmemory-demo.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/resources": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/semantic-conventions": "^1.23.0",
    "@rdcp.dev/otel-plugin": "file:../otel-plugin",
    "@rdcp.dev/server": "file:../..",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
